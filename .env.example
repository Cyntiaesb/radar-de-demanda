# Radar de Demanda Lite BR — variáveis de ambiente

# Obrigatório: chave Anthropic do usuário (BYO key)
ANTHROPIC_API_KEY=sk-ant-...

# Opcional: Reddit, Reclame Aqui, Mercado Livre, Google Trends e anúncios da Meta pelo Apify.
# Sem token, essas fontes viram links para abrir à mão.
# Token em console.apify.com -> Settings -> API & Integrations
APIFY_TOKEN=
# Máximo que uma rodada pode gastar no Apify, somando as 5 fontes (em dólar)
APIFY_TETO_USD=1.00

# Opcional: limites
RADAR_MAX_REDDIT_POSTS=200
RADAR_MAX_AUTOCOMPLETE_QUERIES=300
